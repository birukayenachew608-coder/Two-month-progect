# Server Port (Dynamic on Cloud Hosting platforms like Render, Railway, Heroku)
PORT=3000

# Base Application URL (Required for OAuth callbacks and Chapa return/webhook URLs)
APP_URL=https://joblink-ethiopia.onrender.com

# Database Configuration (MySQL / Aiven / Local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=joblink_ethiopia
DB_SSL=false
# Alternatively, you can supply a single cloud Service URI:
# DATABASE_URL=mysql://avnadmin:password@mysql-xxxx.aivencloud.com:22168/defaultdb?ssl-mode=REQUIRED

# Security & Admin IP Whitelist (Keep false on Render/Cloud unless strict IP restrictions are required)
ENABLE_STRICT_IP_WHITELIST=false

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# Email Service (HTTP REST API - Port 443 / Bypasses Render Port Blocks)
# Option 1 (Recommended for no-domain testing): Brevo (https://brevo.com)
# 300 free emails/day, can send to ANY recipient using your verified account email.
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_USER=your_verified_sender_email@gmail.com

# Option 2: Resend (https://resend.com)
# 100 free emails/day. (Note: Without custom domain verification, only sends to your account email).
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM="JobLink Ethiopia <onboarding@resend.dev>"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=https://joblink-ethiopia.onrender.com/api/auth/google/callback

# LinkedIn OAuth 2.0 Credentials
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_CALLBACK_URL=http://localhost:3000/api/auth/linkedin/callback

# Chapa Payment Gateway Configuration
CHAPA_SECRET_KEY=your_chapa_secret_key_here
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_here
